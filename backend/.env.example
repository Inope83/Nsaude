# Copy to .env and fill in. Never commit .env.
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (leave unset to use SQLite in development)
# POSTGRES_DB=saudekonekta
# POSTGRES_USER=saude
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# HTTPS (production)
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
USE_X_FORWARDED_PROTO=false
# Full origin(s) for cross-origin form posts behind a proxy, e.g.
# CSRF_TRUSTED_ORIGINS=https://saudekonekta.tl
CSRF_TRUSTED_ORIGINS=
